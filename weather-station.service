[Unit]
Description=Outback Electronics Weather Station Sensor Reader
After=network.target

[Service]
Type=simple
User=outbackelectronics
WorkingDirectory=/home/outbackelectronics
ExecStart=/usr/bin/python3 /home/outbackelectronics/weather_station.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
EnvironmentFile=-/home/outbackelectronics/.env

[Install]
WantedBy=multi-user.target
