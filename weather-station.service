[Unit]
Description=Outback Electronics Weather Station Sensor Reader
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/outbackelectronics
ExecStart=/usr/bin/python3 /home/pi/outbackelectronics/weather_station.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
Environment=WEATHER_API_KEY=
Environment=WEATHER_URL=https://weather.outbackelectronics.com.au
Environment=STATION_ID=station-01
Environment=WEATHER_INTERVAL=30

[Install]
WantedBy=multi-user.target
